#!/usr/bin/env sh
# Distillery Expo — one-command installer/launcher (M2)
#
# Design:
#   - Fedora first (what Bruce runs today)
#   - Steam Deck / SteamOS / Arch via pacman (keyring init/populate before -Sy)
#   - Portable by default: POSIX sh + python3 + node/npm only
#   - No apt-only paths, no glibc-only assumptions, no Linux-only hard deps
#   - macOS (incl. Apple Silicon): same commands; brew notes in bootstrap
#
# Roles:
#   scripts/bootstrap.sh  = bare-machine path (system toolchain + deps + Expo)
#                           public one-liner:
#                           curl -fsSL https://raw.githubusercontent.com/Memberoffoxhound/Distillery-Expo/main/scripts/bootstrap.sh | sh
#   scripts/dev-up        = day-to-day after toolchain is present
#                           (venv + pip + npm + launch). On Fedora/Arch/SteamOS,
#                           if python3/node/npm/adb are missing, auto-installs via
#                           dnf or pacman (with pacman-key --init/--populate)
#                           or Homebrew (android-platform-tools) instead of only dying.
#
# Usage (from repo root):
#   ./scripts/dev-up
#
# Lands you at http://127.0.0.1:5173 — then Pull mici route → Pack shards → Teach → Train → Export → Eval → gated Flash

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"

API_PORT="${DISTILLERY_API_PORT:-8000}"
WEB_PORT="${DISTILLERY_WEB_PORT:-5173}"
VENV_DIR="${DISTILLERY_VENV:-$ROOT/.venv}"

info()  { printf '%s\n' "$*"; }
warn()  { printf 'warn: %s\n' "$*" >&2; }
die()   { printf 'error: %s\n' "$*" >&2; exit 1; }

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

detect_os() {
  # Portable uname — do not assume Linux. macOS follow-on hooks go here.
  case "$(uname -s 2>/dev/null || echo unknown)" in
    Linux*)  echo linux ;;
    Darwin*) echo macos ;;
    *)       echo other ;;
  esac
}

is_fedora_like() {
  have_cmd dnf || have_cmd microdnf || {
    [ -f /etc/fedora-release ] || [ -f /etc/redhat-release ]
  }
}

os_release_id() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '%s' "${ID:-}"
  fi
}

os_release_id_like() {
  if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '%s' "${ID_LIKE:-}"
  fi
}

is_arch_like() {
  have_cmd pacman || {
    _id=$(os_release_id)
    _like=$(os_release_id_like)
    case "$_id" in
      steamos|arch|endeavouros|manjaro|cachyos|garuda|archarm) return 0 ;;
    esac
    case " $_like " in
      *" arch "*|*" archlinux "*) return 0 ;;
    esac
    return 1
  }
}

is_steamos() {
  _id=$(os_release_id)
  [ "$_id" = "steamos" ] && return 0
  have_cmd steamos-readonly && return 0
  return 1
}

maybe_disable_steamos_readonly() {
  if ! have_cmd steamos-readonly; then
    return 0
  fi
  info "SteamOS detected — ensuring writable root (steamos-readonly disable) …"
  if have_cmd sudo; then
    sudo steamos-readonly disable || warn "steamos-readonly disable failed — if pacman fails, run it manually"
  else
    steamos-readonly disable || warn "steamos-readonly disable failed — run as root, then re-run"
  fi
}

# Run pacman / pacman-key as root when sudo exists (Deck Desktop).
pacman_sudo() {
  if have_cmd sudo; then
    sudo "$@"
  else
    "$@"
  fi
}

# After steamos-readonly disable (or on a fresh Arch image), the keyring DB
# is often empty / not writable until init + populate. Must run before -Sy.
die_pacman_keyring_help() {
  die "pacman keyring / package install failed (common on Steam Deck after unlocking the read-only root).

On Steam Deck Desktop, fix the keyring, then re-run ./scripts/dev-up (or ./scripts/bootstrap.sh):

  sudo steamos-readonly disable
  sudo pacman-key --init
  sudo pacman-key --populate archlinux
  # if these keyrings exist on your Deck:
  sudo pacman-key --populate steamos
  sudo pacman-key --populate holo
  sudo pacman -Sy --needed python python-pip python-virtualenv nodejs npm android-tools

Prefer fixing pacman. If you must unblock without it: install Node LTS
(https://nodejs.org) and Python 3 with venv another way, then re-run."
}

keyring_files_exist() {
  _kr=$1
  [ -d /usr/share/pacman/keyrings ] || return 1
  [ -e "/usr/share/pacman/keyrings/${_kr}.gpg" ] && return 0
  [ -e "/usr/share/pacman/keyrings/${_kr}-revoked" ] && return 0
  # Some images ship a directory or multiple files prefixed by the name
  for _f in /usr/share/pacman/keyrings/"${_kr}"*; do
    [ -e "$_f" ] && return 0
  done
  return 1
}

ensure_pacman_keyring() {
  # Idempotent across multiple ensure_cmd calls in one run.
  if [ "${_DISTILLERY_PACMAN_KEYRING_READY:-0}" = "1" ]; then
    return 0
  fi

  info "pacman keyring: init …"
  if ! pacman_sudo pacman-key --init; then
    warn "pacman-key --init failed"
    die_pacman_keyring_help
  fi
  info "pacman keyring: init OK"

  _populated=0
  for _kr in archlinux steamos holo; do
    if keyring_files_exist "$_kr"; then
      info "pacman keyring: populate ${_kr} …"
      if pacman_sudo pacman-key --populate "$_kr"; then
        info "pacman keyring: populate ${_kr} OK"
        _populated=1
      else
        warn "pacman-key --populate ${_kr} failed"
      fi
    fi
  done

  # Fresh Arch containers always expect archlinux; try once more if nothing matched.
  if [ "$_populated" = "0" ]; then
    info "pacman keyring: populate archlinux (no keyring files detected earlier) …"
    if pacman_sudo pacman-key --populate archlinux; then
      info "pacman keyring: populate archlinux OK"
      _populated=1
    else
      warn "pacman-key --populate archlinux failed"
    fi
  fi

  if [ "$_populated" = "0" ]; then
    die_pacman_keyring_help
  fi

  _DISTILLERY_PACMAN_KEYRING_READY=1
}

pacman_install() {
  pkgs=$1
  if is_steamos || have_cmd steamos-readonly; then
    info "Steam Deck / SteamOS — writable root, then keyring, then pacman"
    maybe_disable_steamos_readonly
  fi
  # Keyring must be writable/populated before -Sy (Deck + fresh Arch).
  ensure_pacman_keyring
  info "installing via pacman: $pkgs"
  info "(may prompt for sudo password; bare machines prefer ./scripts/bootstrap.sh)"
  # shellcheck disable=SC2086
  if ! pacman_sudo pacman -Sy --needed --noconfirm $pkgs; then
    warn "pacman -Sy failed after keyring setup"
    die_pacman_keyring_help
  fi
}

OS=$(detect_os)

# --- toolchain: Fedora dnf / Arch pacman auto-install; otherwise point at bootstrap ---
ensure_cmd() {
  cmd=$1
  dnf_pkgs=$2
  pacman_pkgs=$3
  # Optional 4th arg: Homebrew formula(s). Empty → macOS falls through to die with python/node hint.
  brew_pkgs=${4:-}
  if have_cmd "$cmd"; then
    return 0
  fi

  if [ "$OS" = "linux" ] && (is_fedora_like || have_cmd dnf || have_cmd microdnf); then
    DNF=dnf
    have_cmd dnf || DNF=microdnf
    info "missing \`$cmd\` — installing via $DNF: $dnf_pkgs"
    info "(may prompt for sudo password; for bare machines prefer ./scripts/bootstrap.sh)"
    # shellcheck disable=SC2086
    if have_cmd sudo; then
      sudo "$DNF" install -y $dnf_pkgs
    else
      "$DNF" install -y $dnf_pkgs
    fi
    if have_cmd "$cmd"; then
      info "installed \`$cmd\` OK"
      return 0
    fi
    die "still missing \`$cmd\` after dnf install. Try: ./scripts/bootstrap.sh"
  fi

  if [ "$OS" = "linux" ] && (is_arch_like || have_cmd pacman); then
    info "missing \`$cmd\` — installing via pacman: $pacman_pkgs"
    pacman_install "$pacman_pkgs"
    if have_cmd "$cmd"; then
      info "installed \`$cmd\` OK"
      return 0
    fi
    die "still missing \`$cmd\` after pacman install. Try: ./scripts/bootstrap.sh
On Steam Deck: sudo steamos-readonly disable && sudo pacman-key --init && sudo pacman-key --populate archlinux && sudo pacman -Sy --needed $pacman_pkgs"
  fi

  if [ "$OS" = "macos" ]; then
    if have_cmd brew && [ -n "$brew_pkgs" ]; then
      info "missing \`$cmd\` — installing via Homebrew: $brew_pkgs"
      # shellcheck disable=SC2086
      brew install $brew_pkgs
      if have_cmd "$cmd"; then
        info "installed \`$cmd\` OK"
        return 0
      fi
      die "still missing \`$cmd\` after brew install. Try: ./scripts/bootstrap.sh"
    fi
    die "missing \`$cmd\`. Install with Homebrew (brew install ${brew_pkgs:-python node}), or run ./scripts/bootstrap.sh"
  fi

  die "missing \`$cmd\` and no supported package manager found.

  Fedora / RHEL:   sudo dnf install $dnf_pkgs
  Arch / SteamOS:  sudo steamos-readonly disable   # Steam Deck only
                   sudo pacman-key --init
                   sudo pacman-key --populate archlinux
                   sudo pacman -Sy --needed $pacman_pkgs
  macOS:           brew install ${brew_pkgs:-python node}

Or bare-machine one-shot: ./scripts/bootstrap.sh
  (public one-liner: curl -fsSL https://raw.githubusercontent.com/Memberoffoxhound/Distillery-Expo/main/scripts/bootstrap.sh | sh)"
}

info "Distillery Expo — one-command bring-up (os=$OS)"
info "Repo: $ROOT"
info ""

# Fedora dnf / Arch|SteamOS pacman / macOS brew (via bootstrap).
# Linux/Fedora:  sudo dnf install python3 python3-pip nodejs npm
# Arch/SteamOS:  sudo pacman-key --init/--populate then pacman -Sy --needed …
# macOS:         brew install python node

# ADB — same packages as bootstrap; soft-warn on unsupported Linux (no dnf/pacman)
# so Expo still lands. Fedora/Arch/macOS install hard (die if still missing).
ensure_adb() {
  if have_cmd adb; then
    info "adb already present: $(adb version 2>/dev/null | head -n 1 || echo on PATH)"
    return 0
  fi

  info "missing \`adb\` — installing (Fedora/Arch: android-tools · macOS: android-platform-tools)"

  if [ "$OS" = "linux" ] && (is_fedora_like || have_cmd dnf || have_cmd microdnf); then
    DNF=dnf
    have_cmd dnf || DNF=microdnf
    info "installing via $DNF: android-tools"
    info "(may prompt for sudo password; for bare machines prefer ./scripts/bootstrap.sh)"
    if have_cmd sudo; then
      sudo "$DNF" install -y android-tools
    else
      "$DNF" install -y android-tools
    fi
  elif [ "$OS" = "linux" ] && (is_arch_like || have_cmd pacman); then
    info "installing via pacman: android-tools"
    pacman_install "android-tools"
  elif [ "$OS" = "macos" ]; then
    if have_cmd brew; then
      info "installing via Homebrew: android-platform-tools"
      brew install android-platform-tools
    else
      die "missing \`adb\`. Install Homebrew from https://brew.sh then: brew install android-platform-tools"
    fi
  else
    warn "adb not found and no dnf/pacman/brew — install android-tools (or android-platform-tools) manually"
    warn "Expo will still start; ADB discovery reports not_on_path until adb is installed"
    return 0
  fi

  if have_cmd adb; then
    info "installed \`adb\` OK: $(adb version 2>/dev/null | head -n 1 || echo installed)"
    return 0
  fi
  die "still missing \`adb\` after install.
  Fedora / RHEL:   sudo dnf install -y android-tools
  Arch / SteamOS:  sudo pacman -Sy --needed android-tools
  macOS:           brew install android-platform-tools
Or: ./scripts/bootstrap.sh"
}

ensure_cmd python3 "python3 python3-pip" "python python-pip python-virtualenv"
ensure_cmd node "nodejs npm" "nodejs npm"
ensure_cmd npm "npm" "npm"
ensure_adb

PY_VER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
info "python3 $PY_VER · node $(node -v) · npm $(npm -v) · adb $(command -v adb >/dev/null && adb version 2>/dev/null | head -n1 || echo missing)"

# --- Python venv + editable install ---
if [ ! -d "$VENV_DIR" ]; then
  info "Creating venv at $VENV_DIR …"
  if ! python3 -m venv "$VENV_DIR"; then
    if [ "$OS" = "linux" ] && (is_fedora_like || have_cmd dnf); then
      info "venv failed — installing python3-pip via dnf and retrying…"
      if have_cmd sudo; then sudo dnf install -y python3 python3-pip; else dnf install -y python3 python3-pip; fi
      python3 -m venv "$VENV_DIR"
    elif [ "$OS" = "linux" ] && (is_arch_like || have_cmd pacman); then
      info "venv failed — installing python-virtualenv via pacman and retrying…"
      pacman_install "python python-pip python-virtualenv"
      python3 -m venv "$VENV_DIR"
    else
      die "python3 -m venv failed. Install venv support, or run ./scripts/bootstrap.sh"
    fi
  fi
fi

# shellcheck disable=SC1091
. "$VENV_DIR/bin/activate"

# Idempotent: re-run pip if package missing or --force
NEED_PIP=0
if ! python -c "import distillery_events, distillery_ingest, distillery_shards, api" 2>/dev/null; then
  NEED_PIP=1
fi
if [ "${DISTILLERY_FORCE_PIP:-0}" = "1" ]; then
  NEED_PIP=1
fi
if [ "$NEED_PIP" = "1" ]; then
  info "Installing Python package (pip install -e \".[dev]\") …"
  python -m pip install -q --upgrade pip
  python -m pip install -q -e ".[dev]"
else
  info "Python package already importable — skipping pip."
fi

# --- Web deps ---
WEB_DIR="$ROOT/apps/web"
if [ ! -d "$WEB_DIR/node_modules" ] || [ "${DISTILLERY_FORCE_NPM:-0}" = "1" ]; then
  info "Installing web deps (npm install in apps/web) …"
  (cd "$WEB_DIR" && npm install --silent)
else
  info "apps/web/node_modules present — skipping npm install."
fi

# --- Clean up previous launcher children if re-run ---
API_PID_FILE="$ROOT/.cache/dev-up-api.pid"
WEB_PID_FILE="$ROOT/.cache/dev-up-web.pid"
mkdir -p "$ROOT/.cache"

stop_pidfile() {
  pf=$1
  if [ -f "$pf" ]; then
    old=$(cat "$pf" 2>/dev/null || true)
    if [ -n "${old:-}" ] && kill -0 "$old" 2>/dev/null; then
      kill "$old" 2>/dev/null || true
      sleep 0.3
    fi
    rm -f "$pf"
  fi
}

stop_pidfile "$API_PID_FILE"
stop_pidfile "$WEB_PID_FILE"

# --- Start API + web ---
info ""
info "Starting API on :$API_PORT …"
# Prefer module path that matches installed package layout
uvicorn api.main:app --host 127.0.0.1 --port "$API_PORT" --reload >"$ROOT/.cache/dev-up-api.log" 2>&1 &
echo $! >"$API_PID_FILE"

info "Starting web on :$WEB_PORT …"
(cd "$WEB_DIR" && npm run dev -- --host 127.0.0.1 --port "$WEB_PORT") >"$ROOT/.cache/dev-up-web.log" 2>&1 &
echo $! >"$WEB_PID_FILE"

# Wait briefly for health
i=0
while [ "$i" -lt 40 ]; do
  if python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:$API_PORT/health', timeout=0.5)" 2>/dev/null; then
    break
  fi
  i=$((i + 1))
  sleep 0.25
done

info ""
info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
info "  Expo UI:  http://127.0.0.1:$WEB_PORT"
info "  API:      http://127.0.0.1:$API_PORT/health"
info "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
info ""
info "Simple-user next steps:"
info "  1. Open the Expo URL above"
info "  2. Pull mici route  (ingest — fixture if no device creds)"
info "  3. Pack shards → Teach → Train → Export → Eval → gated Flash"
info "  4. Flash confirm stays locked until eval_passed (never auto-write)"
info ""
info "Logs:  .cache/dev-up-api.log  ·  .cache/dev-up-web.log"
info "Stop:  kill \$(cat .cache/dev-up-api.pid) \$(cat .cache/dev-up-web.pid)"
info ""
info "Re-run safe. Set DISTILLERY_FORCE_PIP=1 / DISTILLERY_FORCE_NPM=1 to reinstall."
info "Bare machine (no python/node)? Use: ./scripts/bootstrap.sh"

# Keep script attached? Prefer exit so Bruce's shell returns; children keep running.
# If foreground preferred later, trap + wait here. For one-command "land in Expo", exit is fine.
exit 0
